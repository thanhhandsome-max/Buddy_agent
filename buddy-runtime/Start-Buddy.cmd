@echo off
setlocal EnableExtensions
title Buddy
pushd "%~dp0" || exit /b 1
set "HERE=%~dp0"
set "OPENCLAW_STATE_DIR=%HERE%state"
if not exist "%OPENCLAW_STATE_DIR%" mkdir "%OPENCLAW_STATE_DIR%"

where node >nul 2>nul || (echo Can cai Node.js 24 truoc: https://nodejs.org & pause & exit /b 1)

rem First run on a new machine: install the prebuilt OpenClaw gateway (one time, a few minutes).
if not exist "%HERE%node_modules\openclaw\openclaw.mjs" (
  echo [Buddy] Cai backend OpenClaw lan dau, vui long cho...
  call npm.cmd install openclaw@2026.11.1 --no-audit --no-fund || (pause & exit /b 1)
)

rem Stable local login token, created once per machine.
if not exist "%OPENCLAW_STATE_DIR%\buddy-token.txt" (
  node -e "require('fs').writeFileSync(process.argv[1],require('crypto').randomBytes(24).toString('hex'))" "%OPENCLAW_STATE_DIR%\buddy-token.txt"
)
set /p BUDDY_TOKEN=<"%OPENCLAW_STATE_DIR%\buddy-token.txt"

rem Gateway config: local only, serves the Buddy UI shipped next to this file.
set "UIROOT=%HERE%control-ui"
set "UIROOT=%UIROOT:\=/%"
> "%OPENCLAW_STATE_DIR%\openclaw.json" (
  echo // Generated by Start-Buddy.cmd
  echo { gateway: { mode: "local", bind: "loopback", port: 18789,
  echo   auth: { mode: "token", token: "%BUDDY_TOKEN%" },
  echo   controlUi: { root: "%UIROOT%" } } }
)

rem Buddy Coder (OpenCode) on 127.0.0.1:4096, unless it is already running.
powershell -NoProfile -Command "if((Test-NetConnection 127.0.0.1 -Port 4096 -WarningAction SilentlyContinue).TcpTestSucceeded){exit 0}else{exit 1}" >nul 2>nul
if errorlevel 1 (
  echo [Buddy] Bat Buddy Coder ^(OpenCode^)...
  start "Buddy Coder (OpenCode)" /min cmd /c "npm.cmd exec --yes --package=@opencode/cli@2.2.6 -- opencode serve --hostname 127.0.0.1 --port 4096"
)

rem Gateway on 127.0.0.1:18789, unless it is already running.
powershell -NoProfile -Command "if((Test-NetConnection 127.0.0.1 -Port 18789 -WarningAction SilentlyContinue).TcpTestSucceeded){exit 0}else{exit 1}" >nul 2>nul
if errorlevel 1 (
  echo [Buddy] Bat gateway...
  start "Buddy Gateway" /min cmd /c "node "%HERE%node_modules\openclaw\openclaw.mjs" gateway run --port 18789 > "%OPENCLAW_STATE_DIR%\gateway.log" 2>&1"
)

echo [Buddy] Dang cho Buddy san sang (lan dau co the mat 1-2 phut)...
powershell -NoProfile -Command "for($i=0;$i -lt 180;$i++){ try{ Invoke-WebRequest -UseBasicParsing -TimeoutSec 2 http://127.0.0.1:18789/ | Out-Null; exit 0 }catch{ Start-Sleep 2 } }; exit 1"
if errorlevel 1 (echo [Buddy] Gateway chua len. Xem state\gateway.log & pause & exit /b 1)

start "" "http://127.0.0.1:18789/buddy/coder#token=%BUDDY_TOKEN%"
echo [Buddy] Da mo Buddy trong trinh duyet. Dong cua so "Buddy Gateway" va "Buddy Coder" de tat.
popd
endlocal
